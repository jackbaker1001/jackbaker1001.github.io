---
/** The Graph State mark, |⬡⟩, drawn inline so it inherits colour and can animate. */
interface Props { height?: number; label?: string; class?: string }
const { height = 40, label, class: cls } = Astro.props;
const MARK = `<path class="kb" d="M13.9 25.0C15.2 25.0 15.9 24.2 15.9 22.6V-72.6C15.9 -74.2 15.2 -75.0 13.9 -75.0C12.6 -75.0 11.9 -74.2 11.9 -72.6V22.6C11.9 24.2 12.6 25.0 13.9 25.0Z" fill="currentColor"/><g stroke="currentColor" stroke-width="3.2"><line x1="69.12" y1="-61.00" x2="37.94" y2="-43.00"/><line x1="37.94" y1="-43.00" x2="37.94" y2="-7.00"/><line x1="37.94" y1="-7.00" x2="69.12" y2="11.00"/><line x1="69.12" y1="11.00" x2="100.30" y2="-7.00"/><line x1="100.30" y1="-7.00" x2="100.30" y2="-43.00"/><line x1="100.30" y1="-43.00" x2="69.12" y2="-61.00"/></g><g stroke="currentColor" stroke-width="3.2" stroke-linecap="round"><line class="kk1" x1="65.86" y1="-50.80" x2="48.40" y2="-40.72"/><line class="kk1" x1="48.40" y1="-9.28" x2="65.86" y2="0.80"/><line class="kk1" x1="93.10" y1="-14.92" x2="93.10" y2="-35.08"/><line class="kk2" x1="45.14" y1="-35.08" x2="45.14" y2="-14.92"/><line class="kk2" x1="72.38" y1="0.80" x2="89.84" y2="-9.28"/><line class="kk2" x1="89.84" y1="-40.72" x2="72.38" y2="-50.80"/></g><circle class="hot" cx="69.12" cy="-61.00" r="6.20"/><g fill="currentColor"><circle class="nd" cx="37.94" cy="-43.00" r="6.20"/><circle class="nd" cx="37.94" cy="-7.00" r="6.20"/><circle class="nd" cx="69.12" cy="11.00" r="6.20"/><circle class="nd" cx="100.30" cy="-7.00" r="6.20"/><circle class="nd" cx="100.30" cy="-43.00" r="6.20"/></g><path class="kb" d="M128.24 -24.2C128.34 -24.4 128.34 -24.7 128.34 -25.0C128.34 -25.3 128.34 -25.6 128.24 -25.8L110.24 -73.5C109.84 -74.5 109.14 -75.0 108.04 -75.0C106.54 -75.0 105.74 -74.2 105.74 -72.6C105.74 -72.3 105.74 -72.0 105.84 -71.8L123.54 -25.0L105.84 21.7C105.74 21.9 105.74 22.2 105.74 22.6C105.74 24.2 106.54 25.0 108.04 25.0C109.14 25.0 109.84 24.5 110.24 23.5Z" fill="currentColor"/>`;
---
<svg
  class:list={['gs-mark', cls]}
  viewBox="7.9 -79.0 124.4 108.0"
  style={`height:${height}px`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={MARK}
/>
<style is:global>
  .gs-mark { width: auto; color: var(--ink); overflow: visible; flex: none; }
  .gs-mark .hot { fill: var(--nitrogen); }
  .gs-mark .kk2 { opacity: 0; }
  .gs-mark .kb { transition: transform .45s var(--ease); }
</style>
