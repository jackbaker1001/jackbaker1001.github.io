---
/**
 * Fixed, washed-out animated scene behind every page (see src/scripts/background.ts).
 * motion="lively" on the home page; "calm" (the default) wherever people read.
 */
interface Props { motion?: 'lively' | 'calm' }
const { motion = 'calm' } = Astro.props;
---
<canvas id="bg-canvas" aria-hidden="true" data-motion={motion}></canvas>
<script>
  import { startBackground } from '../scripts/background';
  const c = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
  if (c) startBackground(c, { calm: c.dataset.motion !== 'lively' });
</script>
<style is:global>
  #bg-canvas {
    position: fixed; inset: 0; z-index: -1;
    width: 100%; height: 100lvh; pointer-events: none;
    /* fade the scene out behind the reading column */
    -webkit-mask-image: radial-gradient(ellipse 46% 62% at 50% 46%, rgb(0 0 0 / .28) 0%, rgb(0 0 0 / .45) 55%, #000 100%);
    mask-image: radial-gradient(ellipse 46% 62% at 50% 46%, rgb(0 0 0 / .28) 0%, rgb(0 0 0 / .45) 55%, #000 100%);
    opacity: .9;
  }
  @media (max-width: 720px) { #bg-canvas { opacity: .6; } }
</style>
