---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap nf">
    <p class="t-label kicker">Error 404</p>
    <h1 class="t-display">|404⟩</h1>
    <p class="t-lead">This page has decohered. Whatever was here collapsed into a state we cannot measure.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Go to the home page <span class="arr">→</span></a>
      <button class="btn" type="button" data-search-open>Search the site</button>
    </div>
  </section>
</Base>
<style>
  .nf { display: grid; gap: var(--space-6); padding-block: var(--space-24); max-width: 760px; }
  .nf h1 { font-size: clamp(72px, 14vw, 160px); line-height: 1; letter-spacing: -0.02em; }
</style>
