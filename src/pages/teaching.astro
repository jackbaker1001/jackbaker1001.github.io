---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Figure from '../components/Figure.astro';
import ieee from '../assets/teaching/jack_at_ieee.jpg';
import punjab from '../assets/teaching/jack_at_univ_punjab.jpg';
import helen from '../assets/teaching/jack_with_helen.jpg';

const courses = [
  { name: 'Practical Physics and Computing 1', code: 'PHAS0007', level: '1st-year undergraduate', text: 'Two terms of programming and laboratory work with a focus on data analysis. Taught for two consecutive years.', href: 'https://www.ucl.ac.uk/module-catalogue/modules/practical-physics-and-computing-1-PHAS0007' },
  { name: 'Practical Physics and Computing 2', code: 'PHAS0029', level: '2nd-year undergraduate', text: 'The sequel to PHAS0007, with coursework built around digital thermometer electronics. Taught the computing component for two years.', href: 'https://www.ucl.ac.uk/module-catalogue/modules/practical-physics-and-computing-2-PHAS0029' },
  { name: 'Computational Physics', code: 'PHAS0030', level: '3rd-year undergraduate', text: 'The strengths and weaknesses of numerical simulation, and an introduction to research software engineering.', href: 'https://www.ucl.ac.uk/module-catalogue/modules/computational-physics-PHAS0030' },
  { name: 'Practical Skills 1P', code: 'PHAS0008', level: '1st-year undergraduate', text: 'Laboratory skills, especially planning and carrying out experiments. Taught for two consecutive years.', href: 'https://www.ucl.ac.uk/module-catalogue/modules/practical-skills-1p-PHAS0008' },
  { name: 'Practical Physics 2A', code: 'PHAS0028', level: '2nd-year undergraduate', text: 'The sequel to PHAS0008, with experiments tied to second-year topics.', href: 'https://www.ucl.ac.uk/module-catalogue/modules/practical-physics-2a-PHAS0028' },
  { name: 'Solid State Physics', code: 'PHAS0041', level: '3rd-year undergraduate', text: 'Electronic and magnetic properties of materials, crystallography and superconductivity.', href: 'https://www.ucl.ac.uk/module-catalogue/modules/solid-state-physics-PHAS0041' },
  { name: 'Advanced Quantum Field Theory', code: 'MSci 4245 / PHY7007U', level: 'Master’s', text: 'A master’s course in quantum field theory, shared with Queen Mary University of London.', href: 'https://web.archive.org/web/20241121224219/https://ph.qmul.ac.uk/sites/default/files/AQFT-courseinfo.pdf', label: 'Course outline (archived)' },
];
const workshops = [
  { year: '2023', title: 'Practical quantum machine learning: time-series analysis with PennyLane and Covalent', where: 'IEEE Quantum Week, Bellevue, Washington', links: [] as { label: string; href: string }[] },
  { year: '2023', title: 'Interdisciplinary Quantum Hackathon (iQuHACK)', where: 'Massachusetts Institute of Technology · virtual competition judge', links: [{ label: 'Web', href: 'https://www.iquise.mit.edu/' }, { label: 'GitHub', href: 'https://github.com/iquhack' }] },
  { year: '2022', title: 'Orchestrating and managing quantum machine learning workflows with Covalent', where: 'IEEE Quantum Week, Broomfield, Colorado', links: [{ label: 'GitHub', href: 'https://github.com/AgnostiqHQ/tutorials_covalent_ieee_2022' }] },
];
---
<Base title="Teaching" image="/og/page/teaching.png" description="Undergraduate and master's teaching at UCL, workshops at IEEE Quantum Week, and education outreach with ORBYTS and the Pak-UK Education Gateway.">
  <PageHead
    kicker="Teaching"
    title="Learning by building"
    lead="I think the physical sciences are learned best through hands-on projects, especially programming ones. Building something makes the concepts stick, joins up the physics and the mathematics, and gives students the satisfaction of seeing the principles work."
  />

  <section class="section wrap" aria-labelledby="ucl-h">
    <div class="section-head"><h2 id="ucl-h" class="t-h2">At University College London</h2></div>
    <p class="measure muted intro">Several years of undergraduate and graduate teaching: lectures, problem-solving seminars, practical workshops and marking.</p>
    <div class="courses">
      {courses.map((c) => (
        <a class="card spot course" href={c.href} target="_blank" rel="noopener">
          <p class="t-label"><span class="kicker">{c.code}</span> · {c.level}</p>
          <h3 class="card-title">{c.name}</h3>
          <p class="muted">{c.text}</p>
          <span class="arrow-link"><span class="lbl">{c.label ?? 'Course page'}</span><span class="arr">↗</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="ws-h">
    <div class="split">
      <div>
        <div class="section-head"><h2 id="ws-h" class="t-h2">Workshops and tutorials</h2></div>
        <p class="muted intro">I travel in Canada and abroad to teach quantum algorithms, machine learning and heterogeneous workflow orchestration.</p>
        <ol class="timeline">
          {workshops.map((w) => (
            <li>
              <span class="t-label yr">{w.year}</span>
              <div>
                <h3 class="tl-title">{w.title}</h3>
                <p class="muted t-small">{w.where}</p>
                {w.links.length > 0 && <p class="tl-links">{w.links.map((l) => <a class="arrow-link" href={l.href} target="_blank" rel="noopener"><span class="lbl">{l.label}</span></a>)}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
      <Figure src={ieee} alt="Jack S. Baker teaching a Covalent workshop at IEEE Quantum Week" photo width={560}>IEEE Quantum Week 2022, Broomfield, Colorado.</Figure>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="adv-h">
    <div class="split">
      <div class="prose">
        <h2 id="adv-h" class="t-h2">Education advocacy and research</h2>
        <p>
          Access to education should be as wide and as equal as we can make it. I have volunteered in education programmes
          and contributed to science education research.
        </p>
        <p>
          <strong><a href="https://www.orbyts.org/">ORBYTS</a></strong> (Original Research By Young Twinkle Students) is a
          multi-award-winning programme that widens access to physics and chemistry, particularly for women and other groups
          under-represented in STEM, and has school students take part in peer-reviewed research. I was a tutor for two years
          and remain an advocate; see our articles in <a href="https://doi.org/10.1088/1361-6552/aa8f2a">Physics Education</a>
          and <a href="https://doi.org/10.1093/astrogeo/atx169">Astronomy &amp; Geophysics</a>.
        </p>
        <p>
          The <strong><a href="https://www.britishcouncil.pk/programmes/education/higher-education/pak-uk-education-gateway">Pak-UK Education Gateway</a></strong>
          builds partnerships between the higher-education sectors of Pakistan and the UK. I travelled to Pakistan as an
          advocate for the programme; the visit was covered by <a href="https://iconn2019.lums.edu.pk/">LUMS</a> and the
          <a href="http://pu.edu.pk/home/section/allpress/10034">University of the Punjab</a>.
        </p>
      </div>
      <Figure src={punjab} alt="Delegates of the Pak-UK Education Gateway at the University of the Punjab" photo width={560}>Pak-UK Education Gateway 2019, University of the Punjab.</Figure>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="ss-h">
    <div class="split narrow-fig">
      <div class="prose">
        <h2 id="ss-h" class="t-h2">Summer school lectures</h2>
        <p>Undergraduate-level lectures at UK summer schools, as a springboard into first-year physics, chemistry and computer science.</p>
        <p>
          <strong>Introduction to computer science</strong> for <a href="https://debatechamber.com/summerschools/">Debate Chamber Summer Schools</a>:
          a week-long series I designed and delivered, covering logic, the history of computing, complexity analysis,
          programming in Java and smartphone app design.
        </p>
        <p>
          <strong>Diatomic constants</strong> at the first ORBYTS summer school: supervising and lecturing on molecular physics
          while students built a database of diatomic constants, with sessions on reading the literature, presenting and molecular vibrations.
        </p>
      </div>
      <Figure src={helen} alt="Jack S. Baker presenting awards with astronaut Helen Sharman" photo width={300}>Presenting awards with astronaut <a class="link" href="https://en.wikipedia.org/wiki/Helen_Sharman">Helen Sharman</a> at the 2017 ORBYTS Summer School, UCL.</Figure>
    </div>
  </section>
</Base>

<style>
  .intro { margin-bottom: var(--space-6); }
  .courses { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-4); }
  .course { display: flex; flex-direction: column; gap: var(--space-2); }
  .course .card-title { font-size: 21px; line-height: 28px; }
  .course .muted { font-size: 16px; line-height: 25px; flex: 1; }
  .course:hover .arrow-link .lbl { background-size: 100% 1px; }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 460px); gap: var(--space-12); align-items: start; }
  .split.narrow-fig { grid-template-columns: minmax(0, 1fr) 260px; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; }
  .timeline li { display: grid; grid-template-columns: 64px 1fr; gap: var(--space-4); padding-block: var(--space-4); border-top: 1px solid var(--line); }
  .tl-title { font-size: 19px; line-height: 27px; }
  .tl-links { display: flex; gap: var(--space-4); margin-top: var(--space-2); }
  .yr { padding-top: 6px; }
  @media (max-width: 860px) { .split, .split.narrow-fig { grid-template-columns: 1fr; } }
</style>
